datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String           @unique
  password      String?
  emailVerified DateTime?
  image         String?
  role          Role             @default(USER)
  accounts      Account[]
  settings      UserSettings?
  permissions   UserPermission[]
  balances      Balance[]
  expenses      Expense[]        @relation("OwnerExpenses")
  cards         Card[]
  shares        ExpenseShare[]
  attributes    Attribute[]
  nameEnc       Bytes?
  rutEnc        Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  identifier String   @unique
  token      String
  expires    DateTime

  @@id([identifier])
}

model UserSettings {
  userId              String  @id
  lowBalanceThreshold Decimal @default(0)
  currency            String  @default("CLP")
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id    String           @id @default(cuid())
  code  String           @unique
  desc  String
  users UserPermission[]
}

model UserPermission {
  userId       String
  permissionId String
  enabled      Boolean    @default(true)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Balance {
  id         String   @id @default(cuid())
  userId     String
  month      Int
  year       Int
  salaryCLP  Decimal
  savingsCLP Decimal  @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

model Card {
  id       String    @id @default(cuid())
  userId   String
  nameEnc  Bytes
  bankType CardType
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

enum CardType {
  DEBIT
  CREDIT
}

enum AccountType {
  COMERCIAL
  CASA
  SUSCRIPCION
  OTRO
}

model Expense {
  id               String      @id @default(cuid())
  ownerId          String
  titleEnc         Bytes
  descriptionEnc   Bytes?
  debtorNameEnc    Bytes?
  type             AccountType
  isSubscription   Boolean     @default(false)
  installments     Int?
  amountTotalCLP   Decimal
  amountPerInstCLP Decimal
  cardId           String?
  createdAt        DateTime    @default(now())

  owner    User               @relation("OwnerExpenses", fields: [ownerId], references: [id], onDelete: Cascade)
  card     Card?              @relation(fields: [cardId], references: [id], onDelete: SetNull)
  schedule Installment[]
  shares   ExpenseShare[]
  tags     ExpenseAttribute[]

  @@index([ownerId, type])
}

model Installment {
  id        String            @id @default(cuid())
  expenseId String
  month     Int
  year      Int
  amountCLP Decimal
  status    InstallmentStatus @default(PENDING)
  expense   Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, month, year])
  @@index([year, month, status])
}

enum InstallmentStatus {
  PENDING
  PAID
  SKIPPED
}

model ExpenseShare {
  expenseId String
  userId    String
  canView   Boolean @default(true)
  canEdit   Boolean @default(false)
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}

enum AttributeKind {
  BANK
  COMMERCIAL_HOUSE
  DEBTOR
  CUSTOM
}

model Attribute {
  id      String             @id @default(cuid())
  userId  String
  kind    AttributeKind
  key     String
  nameEnc Bytes
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  usedBy  ExpenseAttribute[]

  @@unique([userId, kind, key])
}

model ExpenseAttribute {
  expenseId   String
  attributeId String
  expense     Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([expenseId, attributeId])
}

model FeatureFlag {
  key     String  @id
  enabled Boolean @default(false)
}
